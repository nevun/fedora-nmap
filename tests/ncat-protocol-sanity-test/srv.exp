#!/usr/bin/expect

set timeout 10

spawn ncat -vl --sctp 6666

expect {
    eof { exit 2 }
    default { exit 1 }
    "Ncat: Connection from 127.0.0.1" { sleep 1; send -- "ServerSend\r" }
}
expect {
    eof { exit 2 }
    default { exit 1 }
    "ClientSend\r"
}
expect {
    eof { exit 0 }
    default { exit 1 }
}
exit 3

